{
  "name": "bm-web",
  "version": "1.0.0",
  "private": true,
  "description": "BM AgriCare wireframes — Express + EJS + Tailwind",
  "scripts": {
    "build:css": "tailwindcss -i ./src/input.css -o ./public/css/app.css --minify",
    "watch:css": "tailwindcss -i ./src/input.css -o ./public/css/app.css --watch",
    "dev": "npm run build:css && concurrently -k \"npm run watch:css\" \"nodemon server.js\"",
    "start": "npm run build:css && node server.js"
  },
  "dependencies": {
    "ejs": "^3.1.10",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "nodemon": "^3.1.9",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17"
  }
}
