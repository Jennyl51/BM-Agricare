<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('partials/head', { title: 'BM AgriCare — Products' }) %>
  </head>
  <body class="min-h-screen bg-gray-200 pb-28 text-gray-800 antialiased">
    <header
      class="sticky top-0 z-40 border-b-4 border-gray-500 bg-gray-100 pt-[max(0.5rem,env(safe-area-inset-top))] shadow-sm">
      <div class="relative flex items-center justify-center px-3 py-3">
        <button
          type="button"
          class="absolute left-3 flex h-10 w-10 items-center justify-center rounded-md border-2 border-gray-400 bg-gray-50 text-gray-700"
          aria-label="Open menu">
          <svg class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
        <h1 class="text-lg font-bold text-gray-900">Products</h1>
      </div>
    </header>

    <section class="border-b-4 border-gray-500 bg-gray-100">
      <div class="overflow-x-auto px-3 py-4">
        <div class="flex w-max gap-4 pb-1">
          <% const categories = ['Seeds', 'Tools', 'Feed', 'Crop', 'Soil']; %>
          <% categories.forEach(function (name, idx) { %>
          <div class="flex flex-col items-center gap-2">
            <div class="h-16 w-16 shrink-0 overflow-hidden rounded-full border-4 border-gray-500 bg-gray-300">
              <img
                src="<%= placeholder(128, 128, name) %>"
                alt=""
                width="128"
                height="128"
                class="h-full w-full object-cover"
                loading="lazy" />
            </div>
            <span class="max-w-[4rem] text-center text-[10px] font-medium text-gray-600"><%= name %></span>
          </div>
          <% }); %>
        </div>
      </div>
    </section>

    <main class="mx-auto max-w-3xl bg-gray-200 px-3 py-4">
      <div class="grid grid-cols-2 gap-3">
        <% for (let i = 1; i <= 10; i++) { %>
        <article class="border-2 border-gray-400 bg-gray-50">
          <div class="aspect-square overflow-hidden border-b-2 border-gray-400 bg-gray-300">
            <img
              src="<%= placeholder(400, 400, 'Item+' + i) %>"
              alt=""
              width="400"
              height="400"
              class="h-full w-full object-cover"
              loading="lazy" />
          </div>
          <div class="space-y-2 p-2">
            <div class="h-3 w-[88%] rounded bg-gray-600"></div>
            <div class="h-2 w-full rounded bg-gray-400"></div>
            <div class="h-2 w-[70%] rounded bg-gray-300"></div>
          </div>
        </article>
        <% } %>
      </div>
    </main>

    <%- include('partials/bottom-nav') %>
  </body>
</html>
